@@ -199,6 +209,18 @@ enum ImageDecoder {
     /// Export at the source resolution; only the interactive preview shrinks.
     static let exportLongEdge: Int? = nil
 
+    /// Full-source export can otherwise overlap a 48 MP host decode, the
+    /// engine's full-size source/negative buffers and the 16-bit result. On an
+    /// 8 GB iPhone that exceeds the process memory allowance and iOS terminates
