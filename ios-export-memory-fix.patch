+    /// untouched when it already fits; larger files are scaled down while
+    /// preserving their aspect ratio and film-gate crop.
+    static var exportPixelLimit: Int {
+        let processBudget = ProcessInfo.processInfo.physicalMemory / 7
+        let pixelsThatFit = Int(processBudget / 56)
+        return min(24_000_000, max(6_000_000, pixelsThatFit))
+    }
