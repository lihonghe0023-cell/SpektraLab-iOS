-    if (maxLongEdge <= 0 || longEdge <= maxLongEdge) return {};
+    double scale = 1.0;
+    if (maxLongEdge > 0 && longEdge > maxLongEdge) {
+        scale = std::min(scale, double(maxLongEdge) / double(longEdge));
+    }
+    if (maxPixels > 0 && width * height > maxPixels) {
+        scale = std::min(scale, std::sqrt(double(maxPixels) / (double(width) * height)));
+    }
+    if (scale >= 1.0) {
+        if (outputWidth) *outputWidth = width;
+        if (outputHeight) *outputHeight = height;
