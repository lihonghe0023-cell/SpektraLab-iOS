From 88ea22371f9d17465a262fb45c4d5cd827c12732 Mon Sep 17 00:00:00 2001
From: lihonghe0023-cell <lihonghe0023@gmail.com>
Date: Fri, 13 Nov 2026 16:08:25 +0800
Subject: [PATCH] feat(ios): enable experimental 42 MP export

---
 ios/SpektraLab/Import/ImageDecoder.swift | 7 +++++--
 ios/SpektraLab/SpektraLab.entitlements   | 2 ++
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/ios/SpektraLab/Import/ImageDecoder.swift b/ios/SpektraLab/Import/ImageDecoder.swift
index 4a90d8a..57b3502 100644
--- a/ios/SpektraLab/Import/ImageDecoder.swift
+++ b/ios/SpektraLab/Import/ImageDecoder.swift
@@ -216,9 +216,12 @@ enum ImageDecoder {
     /// untouched when it already fits; larger files are scaled down while
     /// preserving their aspect ratio and film-gate crop.
     static var exportPixelLimit: Int {
-        let processBudget = ProcessInfo.processInfo.physicalMemory / 7
+        // With the increased-memory entitlement, an 8 GB phone gets a budget
+        // large enough to keep a 33 MP source native and cap larger exports at
+        // 42 MP. Lower-memory devices still scale down to their own budget.
+        let processBudget = ProcessInfo.processInfo.physicalMemory * 2 / 7
         let pixelsThatFit = Int(processBudget / 56)
-        return min(24_000_000, max(6_000_000, pixelsThatFit))
+        return min(42_000_000, max(6_000_000, pixelsThatFit))
     }
 
     /// The exact float working space used by the Mac 1.3.5 decoder.
diff --git a/ios/SpektraLab/SpektraLab.entitlements b/ios/SpektraLab/SpektraLab.entitlements
index 2cb402d..834fe71 100644
--- a/ios/SpektraLab/SpektraLab.entitlements
+++ b/ios/SpektraLab/SpektraLab.entitlements
@@ -2,6 +2,8 @@
 <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
 <plist version="1.0">
 <dict>
+	<key>com.apple.developer.kernel.increased-memory-limit</key>
+	<true/>
 	<!-- The app has no App Sandbox entitlement of its own on iOS: the
 	     sandbox is the platform's, and the app writes only to its own
 	     container and to the photo library. -->
-- 
2.56.0.windows.4

